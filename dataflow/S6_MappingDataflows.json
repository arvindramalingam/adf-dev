{
	"name": "S6_MappingDataflows",
	"properties": {
		"folder": {
			"name": "S6_Dataflow"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "MultiLine_Source",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "S3_DESTINATION",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     sapKeyColumns as string[]",
				"}",
				"source(output(",
				"          Name as string,",
				"          Address as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     multiLineRow: true) ~> source1",
				"source1 derive(hashbytes = sha2(256, reduce(array(byNames($sapKeyColumns)), '', #acc + iif(length(#acc) > 0, '|_|', '') + iif(isNull(#item), '', toString(#item)), #result)),",
				"          testhashinput = reduce(array(byNames($sapKeyColumns)), '', #acc + iif(or( and(length(#acc) > 0, not(and(length(#acc)==3, right(#acc, 3) == '|_|')) ),and(not(length(#acc) > 0), isNull(#item)) ), '|_|', '') + iif(isNull(#item), '', toString(#item)), #result),",
				"          extractdate = toString(currentTimestamp(), 'yyyy-MM-dd HH-mm-ss')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Name as string,",
				"          Age as string,",
				"          Sex as string,",
				"          Qualification as string",
				"     ),",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('key',",
				"          0,",
				"          extractdate",
				"     )) ~> sink1"
			]
		}
	}
}